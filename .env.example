# Database (PostgreSQL 连接串，部署前必须填写)
# Neon 示例（请使用直连端点，pooled 端点走 PgBouncer 会破坏事务）：
# DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=postgresql://user:password@host:5432/dbname

# 会话与验证码密钥（生成方式: openssl rand -base64 32）
# NUXT_SESSION_PASSWORD: 会话 Cookie 密封密钥，生产环境必填，32 位以上随机串
# AUTH_SECRET: 邮箱验证码 HMAC 密钥；留空时 seed 会自动生成并写入数据库 AppSetting
NUXT_SESSION_PASSWORD=
AUTH_SECRET=

# 管理员账号（密码为原始值，seed 会自动 bcrypt 加密；留空则自动生成 8 位随机密码并打印）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_EMAIL=admin@example.com

# Upstash Redis（可选，推荐多实例/Serverless 部署启用）
# 作用：跨实例共享数据缓存 + 认证接口限流计数（多实例下内存实现会失效）
# 注册: https://console.upstash.com 创建 Redis，选 Global/Serverless，REST 模式
# 1. UPSTASH_REDIS_REST_URL 来自数据库详情页 REST API 的 Endpoint
# 2. UPSTASH_REDIS_REST_TOKEN 来自同页 Token（别选 Read only，需要写）
# 不配置则自动降级为单实例内存实现，功能不受影响
# UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
# UPSTASH_REDIS_REST_TOKEN=AXxxxxxxxx

# Resend 邮件服务（自助注册验证码 + 忘记密码验证码，可选但推荐）
# 1. https://resend.com 免费注册
# 2. Add Domain: 填写你的发信域名，按后台给出的 SPF/DKIM 记录到域名服务商添加 DNS
# 3. 创建 API Key（Sending access，re_ 开头）
# RESEND_API_KEY=re_xxx
# RESEND_FROM=OneNav <noreply@your-domain.com>

# 本地开发（可选）
# .env.development 里的 DATABASE_URL 会指向测试库；迁移与 seed 默认只连它，避免误改生产
# 见 README「数据库变更」
