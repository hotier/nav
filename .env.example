# Database (PostgreSQL 连接串，部署前必须填写)
# Neon 示例（推荐直连端点，避免 PgBouncer/pooler）：
# DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=postgresql://user:password@host:5432/dbname

# NextAuth.js（部署时自动生成，无需手动填写）
# 生成方式: openssl rand -base64 32  或  npx auth secret
AUTH_SECRET=

# Admin Password（原始密码，seed.ts 会自动 bcrypt 加密）
# 留空则部署时自动生成 8 位随机密码并打印
ADMIN_PASSWORD=

# OAuth Providers（可选）
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# OpenAI API（可选，AI 功能需要）
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
